<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.hermes.workspace</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_DIR__/scripts/start-hermes-workspace.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__WORKSPACE_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HERMES_HOME__/logs/hermes-workspace.log</string>
  <key>StandardErrorPath</key><string>__HERMES_HOME__/logs/hermes-workspace.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_HOME</key><string>__HERMES_HOME__</string>
    <key>HERMES_WORKSPACE_DIR</key><string>__WORKSPACE_DIR__</string>
  </dict>
</dict>
</plist>
