{
  "_comment": "Hermes heartbeat system-custodian policy. Edit freely; reloaded each run.",
  "phase": 2,
  "_phase_meanings": {
    "1": "observe-only \u2014 agent journals 'would do X' but never acts",
    "2": "escalate-before-act \u2014 every destructive action requires deepseek-v4-flash concurrence",
    "3": "autonomous on allowlist \u2014 destructive actions on allowlisted targets skip the second opinion"
  },
  "quit_app": {
    "allowlist": [
      "Slack",
      "Discord",
      "Spotify",
      "Music",
      "Photos",
      "App Store",
      "Calendar",
      "Reminders",
      "Activity Monitor",
      "System Settings",
      "Maps",
      "Weather",
      "News",
      "Stocks",
      "Podcasts",
      "TV"
    ],
    "denylist": [
      "Claude",
      "Cursor",
      "Code",
      "Visual Studio Code",
      "Xcode",
      "Android Studio",
      "Sublime Text",
      "JetBrains Toolbox",
      "IntelliJ IDEA",
      "PyCharm",
      "WebStorm",
      "GoLand",
      "Terminal",
      "iTerm",
      "iTerm2",
      "Warp",
      "Hyper",
      "Alacritty",
      "Ghostty",
      "Safari",
      "Google Chrome",
      "Arc",
      "Firefox",
      "Brave Browser",
      "Microsoft Edge",
      "Zoom",
      "FaceTime",
      "Microsoft Teams",
      "Webex",
      "OBS",
      "ScreenFlow",
      "QuickTime Player",
      "Logic Pro",
      "GarageBand",
      "Final Cut Pro",
      "DaVinci Resolve",
      "Simulator",
      "Docker Desktop",
      "OrbStack",
      "1Password",
      "Bitwarden",
      "Hermes",
      "Cartha Agent",
      "Cartha",
      "BlueBubbles",
      "Messages",
      "Mail",
      "Notes",
      "TextEdit",
      "Preview",
      "Finder"
    ],
    "_note": "denylist takes precedence over allowlist. If an app appears in both, it will NOT be quit."
  },
  "cleanup": {
    "enabled_actions": [
      "empty_trash",
      "clean_xcode_derived_data",
      "clean_ios_simulator_caches",
      "clean_tmp_old"
    ],
    "_available_actions": [
      "empty_trash",
      "clean_xcode_derived_data",
      "clean_ios_simulator_caches",
      "clean_tmp_old",
      "clean_npm_cache",
      "clean_yarn_cache",
      "clean_pip_cache",
      "clean_homebrew_cache",
      "clean_docker_images"
    ],
    "_note": "Only actions in enabled_actions are eligible. Each still requires deepseek concurrence in phase 2."
  },
  "memory_pressure_threshold_pct": 75,
  "cpu_pressure_threshold_pct": 80,
  "min_ram_mb_to_consider_quit": 500,
  "trusted_autonomy": {
    "enabled": true,
    "max_steps": 10,
    "default_timeout_seconds": 120,
    "max_total_seconds": 900,
    "allowed_roots": [
      "~/.hermes/scripts",
      "~/.hermes/hermes-agent",
      "~/Documents/GitHub",
      "~/My Drive/Moltbot-Shared/Documents/GitHub"
    ],
    "_note": "Standing authorization for direct Cartha Agent tasks. Allows inspect/edit/test/build/git add/commit/non-force push inside allowed_roots. Still blocks secrets, sudo, broad deletes, force push, cloud/infrastructure mutation, package publishing, and store submission."
  }
}
