# Copy this to ~/.hermes/.env or let scripts/install.mjs create it.
# Never commit real values.

API_SERVER_ENABLED=true
API_SERVER_KEY=replace-with-random-token
API_SERVER_CORS_ORIGINS=http://127.0.0.1:5128,http://localhost:5128,http://127.0.0.1:3000,http://localhost:3000

# Required for OpenRouter-hosted agent/small models.
OPENROUTER_API_KEY=

# Optional web workspace password. scripts/install.mjs will create one if missing.
HERMES_PASSWORD=replace-with-random-password

# Optional local console overrides.
HERMES_UI_HOST=127.0.0.1
HERMES_UI_PORT=5128
HERMES_API_BASE=http://127.0.0.1:8642/v1
OLLAMA_API_BASE=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma4:31b-hermes
OPENROUTER_AGENT_MODEL=xiaomi/mimo-v2.5-pro
OPENROUTER_SMALL_MODEL=deepseek/deepseek-v4-flash
