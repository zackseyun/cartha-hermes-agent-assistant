{
  "name": "cartha-hermes-agent-assistant",
  "version": "0.2.0",
  "description": "Cartha Hermes Agent Assistant — a batteries-included local AI assistant stack: Hermes gateway, dashboard, workspace UI, operator console, autonomous heartbeat custodian, and self-hosted SearXNG web search backend.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cartha-hermes-agent-assistant": "./scripts/install.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "HERMES_UI_PORT=5128 node --watch server.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check lib/*.mjs && node --check scripts/*.mjs && node --test tests/*.test.mjs && node scripts/test-runtime-store.mjs",
    "smoke": "node scripts/smoke.mjs",
    "install:stack": "node scripts/install.mjs",
    "searxng:start": "bash templates/searxng/start-searxng.sh",
    "reset:openrouter": "node scripts/reset-openrouter-pool.mjs",
    "native:build": "bash scripts/build-native-app.sh",
    "native:open": "bash scripts/open-native-app.sh",
    "native:install-launch-agent": "bash scripts/install-native-launch-agent.sh",
    "mobile:bridge": "node scripts/mobile-bridge.mjs",
    "mobile:configure": "node scripts/configure-mobile-bridge.mjs",
    "mobile:install-launch-agent": "node scripts/install-mobile-bridge-launch-agent.mjs",
    "mobile:deploy-ios": "node scripts/deploy-hermes-iphone.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "server.mjs",
    "lib",
    "public",
    "scripts",
    "templates",
    "native",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
